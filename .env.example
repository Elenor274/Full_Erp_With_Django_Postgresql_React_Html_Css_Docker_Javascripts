# .env.example
# Environmental Configuration File — Copy to .env for local deployment

# Django Core Security Settings
SECRET_KEY=your-secure-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=textile_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Set to True if you want to bypass PostgreSQL and use SQLite for local quick test
USE_SQLITE=False

# Cookie Security Settings (Set to False for local HTTP network development)
ENABLE_SECURE_COOKIES=False

# CSRF Trusted Origins (Comma separated for local network testing)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
